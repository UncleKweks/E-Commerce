PORT=8080
GIN_MODE=debug
# Comma-separated list of frontend URLs allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=ecommerce_shop
DB_SSLMODE=disable

# Required, at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=168h

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=ecommerce-uploads
AWS_S3_ENDPOINT=http://localhost:4566

UPLOAD_PATH=./uploads
# Maximum upload size in bytes (100 MB)
MAX_UPLOAD_SIZE=104857600
